# === Core ===
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://sakti:sakti@db:5432/sakti
REDIS_URL=redis://redis:6379/0
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sakti-graph-2026

# === LLM — FREE-FIRST (zero keys needed for MVP demo) ===
# Default = 100% free, offline, no billing. Paid keys are OPTIONAL upgrades.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_PROVIDER=offline
LLM_MODEL=offline-extractive
OLLAMA_URL=http://localhost:11434

# Optional paid upgrades (only if you want them):
OPENAI_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=
HF_API_KEY=

# === Vector Store — FREE, open-source ===
VECTOR_STORE=pgvector
QDRANT_URL=http://qdrant:6333

# === Bhashini — FREE govt infra (SIH bonus points) ===
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# === Observability ===
LOG_LEVEL=INFO
ENABLE_AUDIT=true
# Extra browser origins allowed to call the API (comma-separated), e.g. a custom dev port
CORS_EXTRA_ORIGINS=
